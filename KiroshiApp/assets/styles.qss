/* mode:light */
QWidget {
    background-color: #f6f7fb;
    color: #1b1f2a;
    font-family: "Segoe UI", "Roboto", "Noto Sans", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #f6f7fb;
}

QMenuBar, QToolBar {
    background-color: #ffffff;
    color: #1b1f2a;
    border: none;
}

QMenuBar::item:selected, QMenu::item:selected {
    background-color: #ffe3e6;
    color: #a50f27;
}

QStatusBar {
    background-color: #ffffff;
    color: #4a5568;
    border-top: 1px solid #d9dee7;
}

QTabWidget::pane {
    border: 1px solid #d9dee7;
    border-radius: 10px;
    background-color: #ffffff;
    padding: 10px;
}

QTabBar::tab {
    background-color: transparent;
    color: #4a5568;
    padding: 6px 18px;
    margin: 2px 4px;
    border-radius: 8px;
    border: 1px solid transparent;
    font-weight: 600;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #b2122d;
    border: 1px solid #e31837;
    box-shadow: 0px 4px 12px rgba(227, 24, 55, 0.18);
}

QTabBar::tab:hover {
    background-color: #ffecef;
    color: #b2122d;
}

QPushButton {
    background-color: #e31837;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 8px 18px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #c70f2b;
}

QPushButton:pressed {
    background-color: #9f0c23;
}

QPushButton:disabled {
    background-color: #f5b8c1;
    color: #ffffff;
}

QLineEdit,
QPlainTextEdit,
QTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #d9dee7;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: #ffe3e6;
    selection-color: #a50f27;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #e31837;
}

QTableView,
QTreeView,
QListView {
    background-color: #ffffff;
    border: 1px solid #d9dee7;
    border-radius: 10px;
    alternate-background-color: #f1f4f9;
    gridline-color: #e2e7ef;
    selection-background-color: #ffe3e6;
    selection-color: #a50f27;
}

QHeaderView::section {
    background-color: #eef2f9;
    color: #4a5568;
    padding: 6px 10px;
    border: none;
    border-right: 1px solid #d9dee7;
    font-weight: 600;
}

QToolTip {
    background-color: #17202a;
    color: #ffffff;
    border: 1px solid #c70f2b;
    border-radius: 6px;
    padding: 6px 10px;
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: rgba(27, 31, 42, 0.18);
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(227, 24, 55, 0.45);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QGroupBox {
    border: 1px solid #d9dee7;
    border-radius: 10px;
    margin-top: 16px;
    padding: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #b2122d;
    font-weight: 600;
}

/* mode:dark */
QWidget {
    background-color: #0f172a;
    color: #e2e8f0;
    font-family: "Segoe UI", "Roboto", "Noto Sans", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #0f172a;
}

QMenuBar, QToolBar {
    background-color: #111827;
    color: #e2e8f0;
    border: none;
}

QMenuBar::item:selected, QMenu::item:selected {
    background-color: rgba(255, 76, 91, 0.2);
    color: #ffffff;
}

QStatusBar {
    background-color: #111827;
    color: #94a3b8;
    border-top: 1px solid #1f2937;
}

QTabWidget::pane {
    border: 1px solid #1f2937;
    border-radius: 10px;
    background-color: #111827;
    padding: 10px;
}

QTabBar::tab {
    background-color: transparent;
    color: #94a3b8;
    padding: 6px 18px;
    margin: 2px 4px;
    border-radius: 8px;
    border: 1px solid transparent;
    font-weight: 600;
}

QTabBar::tab:selected {
    background-color: #1f2937;
    color: #ffffff;
    border: 1px solid #ff4c5b;
    box-shadow: 0px 6px 16px rgba(255, 76, 91, 0.25);
}

QTabBar::tab:hover {
    background-color: rgba(255, 76, 91, 0.15);
    color: #ffffff;
}

QPushButton {
    background-color: #ff4c5b;
    color: #0b1120;
    border: none;
    border-radius: 8px;
    padding: 8px 18px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #ff3244;
}

QPushButton:pressed {
    background-color: #e31837;
}

QPushButton:disabled {
    background-color: rgba(255, 76, 91, 0.35);
    color: rgba(255, 255, 255, 0.55);
}

QLineEdit,
QPlainTextEdit,
QTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: #1f2937;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 6px 10px;
    color: #e2e8f0;
    selection-background-color: rgba(255, 76, 91, 0.35);
    selection-color: #ffffff;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #ff4c5b;
}

QTableView,
QTreeView,
QListView {
    background-color: #111827;
    border: 1px solid #1f2937;
    border-radius: 10px;
    alternate-background-color: #16213d;
    gridline-color: #1f2937;
    selection-background-color: rgba(255, 76, 91, 0.35);
    selection-color: #ffffff;
}

QHeaderView::section {
    background-color: #1f2937;
    color: #cbd5f5;
    padding: 6px 10px;
    border: none;
    border-right: 1px solid #273349;
    font-weight: 600;
}

QToolTip {
    background-color: #ff4c5b;
    color: #0b1120;
    border: 1px solid #ff93a0;
    border-radius: 6px;
    padding: 6px 10px;
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: rgba(148, 163, 184, 0.35);
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(255, 76, 91, 0.45);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QGroupBox {
    border: 1px solid #1f2937;
    border-radius: 10px;
    margin-top: 16px;
    padding: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #ff4c5b;
    font-weight: 600;
}
