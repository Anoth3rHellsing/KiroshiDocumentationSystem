/* mode:light */
QWidget {
    background-color: #f5f6f8;
    color: #1f1f1f;
    font-family: "Segoe UI", sans-serif;
    font-size: 10pt;
}

QLineEdit, QTextEdit, QComboBox, QTableView, QTableWidget, QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #cfd8dc;
    border-radius: 4px;
    padding: 4px;
    selection-background-color: #e53935;
    selection-color: #ffffff;
}

QPushButton {
    background-color: #e53935;
    border: none;
    border-radius: 4px;
    color: #ffffff;
    padding: 6px 12px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #ef5350;
}

QPushButton:disabled {
    background-color: #b0bec5;
    color: #eceff1;
}

QTabWidget::pane {
    border-top: 2px solid #e53935;
}

QStatusBar {
    background-color: #eceff1;
    color: #1f1f1f;
}

QMenuBar {
    background-color: #eceff1;
    color: #1f1f1f;
}

QMenuBar::item:selected {
    background-color: #e53935;
    color: #ffffff;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent;
    width: 14px;
    margin: 0px;
}

QScrollBar::handle {
    background: #b0bec5;
    border-radius: 6px;
}

QProgressBar {
    border: 1px solid #cfd8dc;
    border-radius: 6px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #e53935;
    border-radius: 6px;
}

/* mode:dark */
QWidget {
    background-color: #1f1f1f;
    color: #f5f5f5;
    font-family: "Segoe UI", sans-serif;
    font-size: 10pt;
}

QLineEdit, QTextEdit, QComboBox, QTableView, QTableWidget, QPlainTextEdit {
    background-color: #2a2a2a;
    border: 1px solid #424242;
    border-radius: 4px;
    padding: 4px;
    selection-background-color: #ef5350;
    selection-color: #1f1f1f;
}

QPushButton {
    background-color: #ef5350;
    border: none;
    border-radius: 4px;
    color: #1f1f1f;
    padding: 6px 12px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #ff6f61;
}

QPushButton:disabled {
    background-color: #424242;
    color: #888888;
}

QTabWidget::pane {
    border-top: 2px solid #ef5350;
}

QStatusBar {
    background-color: #2a2a2a;
    color: #f5f5f5;
}

QMenuBar {
    background-color: #2a2a2a;
    color: #f5f5f5;
}

QMenuBar::item:selected {
    background-color: #ef5350;
    color: #1f1f1f;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent;
    width: 14px;
    margin: 0px;
}

QScrollBar::handle {
    background: #424242;
    border-radius: 6px;
}

QProgressBar {
    border: 1px solid #424242;
    border-radius: 6px;
    text-align: center;
    color: #f5f5f5;
}

QProgressBar::chunk {
    background-color: #ef5350;
    border-radius: 6px;
}
